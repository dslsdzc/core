fn bigint_blob_byte_from_hex(c: int) -> int:
    if c >= 48 && c <= 57:
        return c - 48
    if c >= 97 && c <= 102:
        return c - 87
    return c - 55

fn bigint_blob_bytes() -> string:
    h := bigint_blob_hex()
    hl := str_len(h)
    n := hl / 2
    out := alloc(n + 1)
    i : ., mut = 0
    loop:
        if i >= n:
            break
        hi := bigint_blob_byte_from_hex(load8(h, i * 2))
        lo := bigint_blob_byte_from_hex(load8(h, i * 2 + 1))
        store8(out, i, hi * 16 + lo)
        i = i + 1
    store8(out, n, 0)
    return out

